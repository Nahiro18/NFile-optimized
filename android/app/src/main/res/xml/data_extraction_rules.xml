<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de copia de seguridad (Android 12+).
  El vault guarda el PIN y el hash de verificacion en SharedPreferences, y los
  archivos cifrados pueden vivir en almacenamiento externo. Nada de esto debe
  salir del dispositivo en una copia de seguridad.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>